# type: ignore

Import('env', 'output_dir')

env = env.Clone()

env = SConscript("../godot-cpp/SConstruct")

env.Append(CPPPATH=[
    "external/",
    "external/godot-cpp/",
    "external/godot-cpp/include/",
    "external/godot-cpp/gen/include/",
    "external/libretro-common/include/",
])

is_windows = env["platform"] == "windows"
is_android = env["platform"] == "android"
is_linux = env["platform"] == "linux"

import os

if is_windows:
    env.Append(CPPPATH=["external/SDL3/include/"])
    env.Append(CXXFLAGS=["/std:c++latest"])
    env.Append(LIBPATH=[r"external/SDL3/lib/x64"])
    env.Append(LIBS=["user32", "gdi32", "opengl32", "SDL3", "vulkan-1"])
    env.Append(LINKFLAGS=['/IGNORE:4099'])
    # Locate vulkan-1.lib: prefer VULKAN_SDK env var, fall back to known install path
    vulkan_sdk = os.environ.get("VULKAN_SDK", r"C:\VulkanSDK\1.4.341.1")
    env.Append(LIBPATH=[vulkan_sdk + r"\Lib"])

if is_android:
    env.Append(CXXFLAGS=["-std=c++20"])
    env.Append(LIBS=["dl", "log", "EGL", "GLESv3", "vulkan"])

if is_linux:
    env.Append(CXXFLAGS=["-std=c++20"])
    env.Append(CPPPATH=["external/SDL3/include/"])
    env.Append(LIBS=["dl", "pthread"])
    # Link the Vulkan loader, SDL3 (OpenGL HW-render context), and the GL loader
    # (direct glReadPixels) by their versioned sonames — distros ship lib*.so.N
    # but the unversioned symlinks that -lvulkan / -lSDL3 / -lGL need come with the
    # -dev/-devel packages, which may not be installed.
    #
    # libvulkan/libGL are near-universal, but SDL3 is new enough that some distros
    # (e.g. Ubuntu 24.04) package it nowhere at all, and upstream ships no prebuilt
    # Linux binary. So a copy is vendored purely to satisfy the linker. It is added
    # with -L only and NOT an rpath: ld records the SONAME (libSDL3.so.0) into
    # DT_NEEDED, and at runtime the loader still picks up the host's own SDL3 from
    # the normal search path. The vendored copy is only ever a link-time stand-in --
    # it is never what the built .so actually calls into.
    #
    # These go in LIBS, not LINKFLAGS: SCons emits LINKFLAGS *before* the object
    # files, and a toolchain defaulting to --as-needed (Ubuntu's does, Fedora's
    # does not) then drops all three, since at that point nothing has referenced a
    # symbol from them yet. The result still links, but silently produces a .so
    # with 44 undefined SDL_/vk*/gl* symbols and no DT_NEEDED entries, which fails
    # at dlopen. LIBS is emitted after the objects, so as-needed keeps them.
    env.Append(LIBS=[":libvulkan.so.1", ":libSDL3.so.0", ":libGL.so.1"])
    env.Append(LIBPATH=["external/SDL3/lib/linux-x64"])

# Vulkan headers (bundled submodule — used on both platforms)
env.Append(CPPPATH=["external/vulkan-headers/include/"])

sources = Glob("src/*.cpp")
sources.extend(Glob("external/libretro-common/compat/*.c"))
sources.remove(File("external/libretro-common/compat/compat_ifaddrs.c"))
sources.extend(Glob("external/libretro-common/encodings/*.c"))

sources.append("external/libretro-common/audio/conversion/s16_to_float.c")
sources.append("external/libretro-common/features/features_cpu.c")
sources.append("external/libretro-common/gfx/scaler/pixconv.c")
sources.append("external/libretro-common/string/stdstring.c")
sources.append("external/libretro-common/file/file_path.c")
sources.append("external/libretro-common/file/file_path_io.c")
sources.append("external/libretro-common/time/rtime.c")
sources.append("external/libretro-common/streams/file_stream.c")
sources.append("external/libretro-common/vfs/vfs_implementation.c")

lib_prefix = "lib" if is_android else ""
library = env.SharedLibrary("{}/{}libretro_godot.{}.{}.{}{}".format(output_dir, lib_prefix, env["platform"], env["target"], env["arch"], env["SHLIBSUFFIX"]), source=sources)

Default(library)
